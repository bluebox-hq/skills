  "item": [
    {
      "name": "Setup",
      "item": [
        {
          "name": "Register the Postman client",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Client registered', () => pm.response.to.have.status(201));",
                  "const clientId = pm.response.json().client_id;",
                  "if (clientId) {",
                  "    pm.collectionVariables.set('client_id', clientId);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/v1/oauth/register",
            "body": {
              "mode": "raw",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"client_name\": \"Postman\",\n  \"redirect_uris\": [\n    \"https://oauth.pstmn.io/v1/callback\",\n    \"https://oauth.pstmn.io/v1/browser-callback\"\n  ],\n  \"grant_types\": [\n    \"authorization_code\",\n    \"refresh_token\"\n  ],\n  \"response_types\": [\n    \"code\"\n  ],\n  \"token_endpoint_auth_method\": \"none\",\n  \"scope\": \"mcp:tools offline_access\"\n}"
            },
            "description": "Registers Postman as a public OAuth client (dynamic client registration) and saves `client_id`. Send it once, before **Get New Access Token**: without `client_id`, sign-in fails with \"Cannot sign in: The app that sent you here is not registered or has been disabled.\" A registration that never gets a token is deleted after 30 days: if sign-in shows that message later, send this again."
          }
        },
        {
          "name": "Protected resource metadata",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/.well-known/oauth-protected-resource/v1/mcp"
          }
        },
        {
          "name": "Authorization server metadata",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/.well-known/oauth-authorization-server"
          }
        }
      ],
      "description": "Send **Register the Postman client** before you select **Get New Access Token** on the collection's **Authorization** tab. It saves `client_id`; without it, sign-in fails with \"Cannot sign in: The app that sent you here is not registered or has been disabled.\"\n\nThe two metadata requests are optional: they show what the server advertises."
    },
    {
      "name": "MCP",
      "item": [
        {
          "name": "initialize",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              },
              {
                "key": "MCP-Protocol-Version",
                "value": "{{protocol_version}}"
              }
            ],
            "url": "{{base_url}}/v1/mcp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"initialize\",\n  \"params\": {\n    \"protocolVersion\": \"{{protocol_version}}\",\n    \"capabilities\": {},\n    \"clientInfo\": {\n      \"name\": \"postman\",\n      \"version\": \"1.0.0\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Optional. The server is stateless and issues no `Mcp-Session-Id`, so every other request works without it. Returns the server's capabilities and instructions."
          }
        },
        {
          "name": "tools/list",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              },
              {
                "key": "MCP-Protocol-Version",
                "value": "{{protocol_version}}"
              }
            ],
            "url": "{{base_url}}/v1/mcp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/list\",\n  \"params\": {}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Lists the tools with their input and output schemas."
          }
        },
        {
          "name": "list_workspaces",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              },
              {
                "key": "MCP-Protocol-Version",
                "value": "{{protocol_version}}"
              }
            ],
            "url": "{{base_url}}/v1/mcp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"list_workspaces\",\n    \"arguments\": {\n      \"limit\": 50\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Lists your workspaces. Sets `{{workspace_id}}` to your default workspace when it is empty. To use another workspace, set `workspace_id` yourself; the other IDs are then cleared."
          }
        },
        {
          "name": "list_repositories",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              },
              {
                "key": "MCP-Protocol-Version",
                "value": "{{protocol_version}}"
              }
            ],
            "url": "{{base_url}}/v1/mcp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"list_repositories\",\n    \"arguments\": {\n      \"workspace_id\": \"{{workspace_id}}\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Lists the repositories connected to the workspace and logs each `repository_id` to the console. Fails if the workspace has no repository connection."
          }
        },
        {
          "name": "list_services",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              },
              {
                "key": "MCP-Protocol-Version",
                "value": "{{protocol_version}}"
              }
            ],
            "url": "{{base_url}}/v1/mcp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"list_services\",\n    \"arguments\": {\n      \"workspace_id\": \"{{workspace_id}}\",\n      \"search\": \"\",\n      \"limit\": 25\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Lists services with `health` and `problem_count`, and logs each `entity_id` to the console. Copy the one you mean into the `entity_id` variable to scope `ask`. Optional filters: `health` (healthy, degraded, unknown), `has_problems`, `repository_url`, `service_name`, `environment`, `search`, `cursor`."
          }
        },
        {
          "name": "list_investigations",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              },
              {
                "key": "MCP-Protocol-Version",
                "value": "{{protocol_version}}"
              }
            ],
            "url": "{{base_url}}/v1/mcp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"list_investigations\",\n    \"arguments\": {\n      \"workspace_id\": \"{{workspace_id}}\",\n      \"repository_id\": \"{{repository_id}}\",\n      \"since\": \"30d\",\n      \"limit\": 25\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Lists investigations (7d by default, up to 365d), filtered by `{{repository_id}}` when it is set. Saves the newest `investigation_id` on every call. Optional filters: `investigation_status`, `entity_id`, `cursor`."
          }
        },
        {
          "name": "get_investigation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              },
              {
                "key": "MCP-Protocol-Version",
                "value": "{{protocol_version}}"
              }
            ],
            "url": "{{base_url}}/v1/mcp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"get_investigation\",\n    \"arguments\": {\n      \"workspace_id\": \"{{workspace_id}}\",\n      \"investigation_id\": \"{{investigation_id}}\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Reads one investigation's report: summary, impact, root cause, recommendation, evidence."
          }
        },
        {
          "name": "ask",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              },
              {
                "key": "MCP-Protocol-Version",
                "value": "{{protocol_version}}"
              }
            ],
            "url": "{{base_url}}/v1/mcp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"ask\",\n    \"arguments\": {\n      \"workspace_id\": \"{{workspace_id}}\",\n      \"question\": \"Are there any active issues in the last 24 hours?\",\n      \"entity_id\": \"{{entity_id}}\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Starts a metered Bluebox run and counts against the workspace's AI usage. Scoped to `{{entity_id}}` when it is set; otherwise Bluebox picks the service from the question, so name the service in it. Waits up to 45s. If `status` is `running`, send `get_ask_result`; sending `ask` again starts a second run. Saves `conversation_id`."
          }
        },
        {
          "name": "get_ask_result",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              },
              {
                "key": "MCP-Protocol-Version",
                "value": "{{protocol_version}}"
              }
            ],
            "url": "{{base_url}}/v1/mcp",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"get_ask_result\",\n    \"arguments\": {\n      \"workspace_id\": \"{{workspace_id}}\",\n      \"conversation_id\": \"{{conversation_id}}\",\n      \"wait\": \"45s\"\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Fetches the answer of a running `ask`. Send it again while `status` is `running`."
          }
        },
        {
          "name": "ask (follow-up)",
          "request": {
            "method": "POST",
