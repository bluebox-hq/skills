  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// IDs belong to one workspace: clear them when workspace_id changes.",
          "// workspace_id and the IDs can also be set in an environment, so read and clear both.",
          "const ws = pm.variables.get('workspace_id') || '';",
          "if (ws !== (pm.collectionVariables.get('ids_workspace_id') || '')) {",
          "    ['entity_id', 'investigation_id', 'repository_id', 'conversation_id'].forEach((k) => {",
          "        if (pm.variables.get(k)) {",
          "            console.log('workspace_id changed: cleared ' + k);",
          "        }",
          "        pm.collectionVariables.set(k, '');",
          "        if (pm.environment.has(k)) {",
          "            pm.environment.set(k, '');",
          "        }",
          "    });",
          "    pm.collectionVariables.set('ids_workspace_id', ws);",
          "}",
          "",
          "// Without its ID, ask (follow-up) and ask (about an investigation) would start a new",
          "// metered run, and get_ask_result and get_investigation would fail: skip the request.",
          "const needs = { conversation_id: 'ask', investigation_id: 'list_investigations' };",
          "const raw = (pm.request.body && pm.request.body.raw) || '';",
          "Object.keys(needs).forEach((k) => {",
          "    if (raw.includes('{{' + k + '}}') && !pm.variables.get(k)) {",
          "        console.warn('Skipped: ' + k + ' is empty. Send ' + needs[k] + ' first.');",
          "        pm.execution.skipRequest();",
          "    }",
          "});",
          "",
          "// With access_token set, send it as a bearer token instead of the collection's OAuth 2.0.",
          "// pm.request.auth is undefined for requests that inherit the collection auth.",
          "const token = pm.variables.get('access_token');",
          "if (token && !(pm.request.auth && pm.request.auth.type === 'noauth')) {",
          "    pm.request.authorizeUsing('bearer', { token: token });",
          "}",
          "",
          "// Drops empty-string tool arguments, so an unset variable such as {{entity_id}}",
          "// is left out of the call instead of failing the tool's input validation.",
          "if (pm.request.method === 'POST' && pm.request.body && pm.request.body.mode === 'raw') {",
          "    let body;",
          "    try {",
          "        body = JSON.parse(pm.variables.replaceIn(pm.request.body.raw));",
          "    } catch (e) {",
          "        body = null;",
          "    }",
          "    const args = body && body.params && body.params.arguments;",
          "    if (args) {",
          "        Object.keys(args).forEach((k) => {",
          "            if (args[k] === '') {",
          "                delete args[k];",
          "            }",
          "        });",
          "        pm.request.body.update(JSON.stringify(body, null, 2));",
          "    }",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Reads the JSON-RPC message from a JSON or an SSE (text/event-stream) response,",
          "// checks it for errors and saves IDs for the next requests.",
          "pm.test('HTTP status is 2xx', () => pm.expect(pm.response.code).to.be.within(200, 299));",
          "",
          "const contentType = pm.response.headers.get('Content-Type') || '';",
          "const text = pm.response.text();",
          "let msg = null;",
          "if (contentType.includes('text/event-stream')) {",
          "    const data = text.split(/\\r?\\n/).filter((l) => l.startsWith('data:'));",
          "    if (data.length) {",
          "        msg = JSON.parse(data[data.length - 1].slice(5));",
          "    }",
          "} else if (contentType.includes('application/json') && text) {",
          "    msg = JSON.parse(text);",
          "}",
          "",
          "if (msg && msg.jsonrpc) {",
          "    pm.test('JSON-RPC call has no error', () => {",
          "        pm.expect(msg.error, JSON.stringify(msg.error)).to.be.undefined;",
          "    });",
          "    const result = msg.result || {};",
          "    if (result.isError) {",
          "        const reason = (result.content || []).map((c) => c.text).join(' ');",
          "        pm.test('Tool call succeeded', () => pm.expect.fail(reason));",
          "    }",
          "",
          "    const sc = result.structuredContent;",
          "    let tool = '';",
          "    try {",
          "        tool = JSON.parse(pm.request.body.raw).params.name || '';",
          "    } catch (e) {",
          "        tool = '';",
          "    }",
          "    if (sc) {",
          "        const items = sc.items || [];",
          "        if (tool === 'list_workspaces' && !pm.variables.get('workspace_id')) {",
          "            // Fill once: a workspace you set yourself is kept.",
          "            const def = sc.meta && sc.meta.default_workspace_id;",
          "            const id = def || (items[0] || {}).workspace_id;",
          "            if (id) {",
          "                pm.collectionVariables.set('workspace_id', id);",
          "                if (def) {",
          "                    // IDs saved so far came from calls without workspace_id, which use the default.",
          "                    pm.collectionVariables.set('ids_workspace_id', id);",
          "                }",
          "                console.log('workspace_id set to ' + id);",
          "            }",
          "        }",
          "        if (tool === 'list_services') {",
          "            // Not saved: copy the entity_id of the service you mean into the entity_id variable.",
          "            items.forEach((s) => console.log((s.service_name || '(no name)') + ' (' + (s.health || 'unknown') + ')  ' + s.entity_id));",
          "        }",
          "        if (tool === 'list_repositories') {",
          "            // Not saved: copy a repository_id into the variable to filter list_investigations.",
          "            items.forEach((r) => console.log((r.full_name || '(no name)') + '  ' + r.repository_id));",
          "        }",
          "        if (tool === 'list_investigations' && items.length) {",
          "            // The newest investigation; replaced on every call.",
          "            const inv = items[0];",
          "            pm.collectionVariables.set('investigation_id', inv.investigation_id);",
          "            console.log('investigation_id set to ' + inv.investigation_id + ': ' + (inv.title || ''));",
          "        }",
          "        if (sc.conversation_id) {",
          "            pm.collectionVariables.set('conversation_id', sc.conversation_id);",
          "        }",
          "        if (sc.status) {",
          "            console.log('ask status: ' + sc.status);",
          "        }",
          "    }",
          "}"
        ]
      }
    }
  ],
